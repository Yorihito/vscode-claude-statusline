{
  "name": "claude-statusline-mirror",
  "displayName": "Claude Code Status Line",
  "description": "Shows Claude Code's usage limits in the VS Code status bar",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeStatusline.refresh",
        "title": "Claude Status Line: Refresh"
      }
    ],
    "configuration": {
      "title": "Claude Code Status Line",
      "properties": {
        "claudeStatusline.staleMinutes": {
          "type": "number",
          "default": 60,
          "description": "Dim the status bar entry once the cached figure is older than this many minutes."
        },
        "claudeStatusline.alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "Which side of the status bar to use (reload required)."
        }
      }
    }
  }
}
